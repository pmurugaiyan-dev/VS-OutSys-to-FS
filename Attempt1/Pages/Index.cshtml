@page "/Trade"
@model DemoApplication.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Trade - New Entries";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1 class="mb-4">Trade Module - New Entries</h1>
        
        <div class="card mb-4">
            <div class="card-header">
                <h5>Add New Entry</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Weight Lbs</label>
                        <input type="text" class="form-control" asp-for="NewEntry.Weight_Lbs">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bar Code</label>
                        <input type="text" class="form-control" asp-for="NewEntry.BarCode">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Branch Name</label>
                        <input type="text" class="form-control" asp-for="NewEntry.BranchName">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Items</label>
                        <input type="text" class="form-control" asp-for="NewEntry.Items">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Time</label>
                        <input type="datetime-local" class="form-control" asp-for="NewEntry.Time">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Final</label>
                        <input type="text" class="form-control" asp-for="NewEntry.Final">
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Save</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5>Entries List</h5>
                <span class="badge bg-info">@Model.Entries.Count() records</span>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Weight Lbs</th>
                            <th>Bar Code</th>
                            <th>Branch Name</th>
                            <th>Items</th>
                            <th>Time</th>
                            <th>Final</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td>@entry.Weight_Lbs</td>
                                <td>@entry.BarCode</td>
                                <td>@entry.BranchName</td>
                                <td>@entry.Items</td>
                                <td>@entry.Time?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@entry.Final</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <a href="/swagger" class="btn btn-secondary">API Documentation</a>
        </div>
    </div>
</body>
</html>
