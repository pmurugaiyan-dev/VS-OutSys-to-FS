@page "/Trade"
@model Trade.Api.Pages.Trade.IndexModel
@{
    ViewData["Title"] = "Trade - NewEntry Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; margin-bottom: 2rem; }
        .card { box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; }
        .status-final { color: #28a745; font-weight: bold; }
        .status-pending { color: #ffc107; font-weight: bold; }
        .btn-api { background: #17a2b8; color: white; }
    </style>
</head>
<body>
    <div class="header">
        <div class="container">
            <h1><i class="bi bi-box-seam"></i> Trade Module</h1>
            <p class="lead mb-0">NewEntry Management - Migrated from OutSystems</p>
        </div>
    </div>

    <div class="container">
        <div class="row mb-4">
            <div class="col-md-6">
                <a href="/swagger" class="btn btn-api" target="_blank">
                    📚 API Documentation (Swagger)
                </a>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addModal">
                    ➕ Add New Entry
                </button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">📋 NewEntry Records</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Bar Code</th>
                                <th>Branch Name</th>
                                <th>Weight (Lbs)</th>
                                <th>Items</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Entries != null && Model.Entries.Any())
                            {
                                @foreach (var entry in Model.Entries)
                                {
                                    <tr>
                                        <td>@entry.Id</td>
                                        <td><code>@entry.BarCode</code></td>
                                        <td>@entry.BranchName</td>
                                        <td>@entry.WeightLbs.ToString("F2")</td>
                                        <td>@entry.Items</td>
                                        <td>@entry.Time.ToString("g")</td>
                                        <td>
                                            @if (entry.Final)
                                            {
                                                <span class="status-final">✔ Final</span>
                                            }
                                            else
                                            {
                                                <span class="status-pending">⏳ Pending</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Trade/Edit/@entry.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@entry.Id" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this entry?')">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">No entries found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <h5 class="card-title">Total Entries</h5>
                        <p class="card-text display-4">@(Model.Entries?.Count() ?? 0)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h5 class="card-title">Finalized</h5>
                        <p class="card-text display-4">@(Model.Entries?.Count(e => e.Final) ?? 0)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <h5 class="card-title">Pending</h5>
                        <p class="card-text display-4">@(Model.Entries?.Count(e => !e.Final) ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">🔗 API Endpoints</h5>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    <li class="list-group-item"><code>GET /api/NewEntry</code> - Get all entries</li>
                    <li class="list-group-item"><code>GET /api/NewEntry/{id}</code> - Get entry by ID</li>
                    <li class="list-group-item"><code>GET /api/NewEntry/{id}/details</code> - Get entry with detail items</li>
                    <li class="list-group-item"><code>POST /api/NewEntry</code> - Create new entry</li>
                    <li class="list-group-item"><code>PUT /api/NewEntry/{id}</code> - Update entry</li>
                    <li class="list-group-item"><code>DELETE /api/NewEntry/{id}</code> - Delete entry</li>
                    <li class="list-group-item"><code>GET /api/NewEntry/branch/{branchName}</code> - Get entries by branch</li>
                    <li class="list-group-item"><code>GET /api/NewEntry/finalized</code> - Get finalized entries</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Add Modal -->
    <div class="modal fade" id="addModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Create">
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Entry</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Bar Code</label>
                            <input type="text" name="BarCode" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Branch Name</label>
                            <input type="text" name="BranchName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Weight (Lbs)</label>
                            <input type="number" name="WeightLbs" step="0.01" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Items</label>
                            <input type="number" name="Items" class="form-control" required />
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="Final" class="form-check-input" id="finalCheck" />
                            <label class="form-check-label" for="finalCheck">Final</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
